# ===================================
# Aary's IDE — Environment Configuration
# ===================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.

# --- Server ---
PORT=3001
HOST=0.0.0.0
NODE_ENV=development
JWT_SECRET=change-me-to-a-random-secret-at-least-32-chars

# --- AI Providers ---
# OmniRoute
OMNIROUTE_API_KEY=
OMNIROUTE_BASE_URL=https://api.omniroute.ai/v1

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# OpenAI
OPENAI_API_KEY=

# Anthropic
ANTHROPIC_API_KEY=

# Google Gemini
GEMINI_API_KEY=

# Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434

# Custom OpenAI-Compatible
CUSTOM_AI_BASE_URL=
CUSTOM_AI_API_KEY=

# --- Authentication ---
# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/auth/google/callback

# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:3001/auth/github/callback

# --- Integrations ---
# WhatsApp Business API
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=change-me-to-a-random-string
WHATSAPP_WEBHOOK_URL=

# --- Storage ---
DATABASE_PATH=./data/aary.db
MEMORY_PATH=./data/memory
WORKSPACE_PATH=./data/workspaces

# --- Security ---
ENCRYPTION_KEY=change-me-to-a-random-32-byte-hex-string
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3001
